{
  "manifest_version": 3,
  "name": "Azota AI Assistant - Smart Screen Capture & Study Solver",
  "version": "1.3.2",
  "description": "Trợ lý học tập thông minh: Chụp màn hình cuộn, phân tích bài tập và đối chiếu đáp án với Google Gemini và OpenAI API (Tương thích đồng thời Kiwi Browser, Firefox Mobile, Chrome & Edge).",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "azota-ai-assistant@minhdepdai.github.io",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "quick_capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Chụp màn hình nhanh"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "html2canvas.min.js",
        "tesseract.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
